    <Item class="ModuleScript" referent="11">
      <Properties>
        <string name="Name">DataService</string>
        <string name="Source"><![CDATA[-- Guardado y carga de progreso con DataStore.
-- Si el place no esta publicado, usa memoria para poder probar en Studio.
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local STORE_NAME = "SpeedEscape_v2"
local cache = {}
local memory = {}
local store = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore no disponible: " .. tostring(result))
		warn("[DataService] El progreso se guardara solo en memoria durante esta sesion.")
	end
end

local function newUpgrades()
	local upgrades = {}
	for key in pairs(Config.Upgrades) do
		upgrades[key] = 0
	end
	return upgrades
end

local function newMissions()
	local missions = {}
	for key in pairs(Config.Missions) do
		missions[key] = { Level = 0, Progress = 0 }
	end
	return missions
end

local function newData()
	return {
		Speed = 0,
		Coins = 0,
		Rebirths = 0,
		Checkpoint = 0,
		Best = 0,
		Upgrades = newUpgrades(),
		Missions = newMissions(),
	}
end

local function toNumber(value, fallback)
	if type(value) == "number" and value == value and value >= 0 then
		return value
	end
	return fallback
end

local function sanitize(raw)
	local data = newData()
	if type(raw) ~= "table" then
		return data
	end
	for _, key in ipairs({ "Speed", "Coins", "Rebirths", "Checkpoint", "Best" }) do
		data[key] = math.floor(toNumber(raw[key], 0))
	end
	if type(raw.Upgrades) == "table" then
		for key, upgrade in pairs(Config.Upgrades) do
			local level = toNumber(raw.Upgrades[key], 0)
			data.Upgrades[key] = math.clamp(math.floor(level), 0, upgrade.MaxLevel)
		end
	end
	if type(raw.Missions) == "table" then
		for key in pairs(Config.Missions) do
			local saved = raw.Missions[key]
			if type(saved) == "table" then
				data.Missions[key].Level = math.clamp(math.floor(toNumber(saved.Level, 0)), 0, 100000)
				data.Missions[key].Progress = math.max(0, math.floor(toNumber(saved.Progress, 0)))
			end
		end
	end
	data.Best = math.max(data.Best, data.Speed)
	return data
end

local DataService = {}

function DataService.Load(player)
	local key = "player_" .. player.UserId
	local raw
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key)
		end)
		if ok then
			raw = result
		else
			warn("[DataService] No se pudo cargar a " .. player.Name .. ": " .. tostring(result))
		end
	else
		raw = memory[key]
	end
	local data = sanitize(raw)
	cache[player] = data
	return data
end

function DataService.Get(player)
	return cache[player]
end

function DataService.Save(player)
	local data = cache[player]
	if not data then
		return false
	end
	local key = "player_" .. player.UserId
	if not store then
		memory[key] = sanitize(data)
		return true
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:SetAsync(key, data)
		end)
		if ok then
			return true
		end
		warn("[DataService] Guardado fallido (" .. attempt .. "/3) para " .. player.Name .. ": " .. tostring(err))
		task.wait(1)
	end
	return false
end

function DataService.Release(player)
	cache[player] = nil
end

return DataService
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Script principal del servidor: estado, remotes, checkpoints, tienda, misiones y prestige.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local DataService = require(script.Parent:WaitForChild("DataService"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
if not Remotes then
	Remotes = Instance.new("Folder")
	Remotes.Name = "Remotes"
	Remotes.Parent = ReplicatedStorage
end

local function ensureRemote(className, name)
	local remote = Remotes:FindFirstChild(name)
	if not remote then
		remote = Instance.new(className)
		remote.Name = name
		remote.Parent = Remotes
	end
	return remote
end

local AddSpeed = ensureRemote("RemoteEvent", "AddSpeed")
local Rebirth = ensureRemote("RemoteEvent", "Rebirth")
local BuyUpgrade = ensureRemote("RemoteEvent", "BuyUpgrade")
local SyncState = ensureRemote("RemoteEvent", "SyncState")
local Notify = ensureRemote("RemoteEvent", "Notify")
local GetState = ensureRemote("RemoteFunction", "GetState")
local FX = ensureRemote("RemoteEvent", "FX")
local Leaderboard = ensureRemote("RemoteEvent", "Leaderboard")

local mapData = MapBuilder.Build()
local spawnLocation = mapData.spawn
local checkpoints = mapData.checkpoints
local coins = mapData.coins

local passCache = {}
local keyBuckets = {}
local comboState = {}
local boostCooldowns = {}
local obstacleCooldowns = {}
local finishCooldowns = {}

local function snapshot(data)
	local upgrades = {}
	for key in pairs(Config.Upgrades) do
		upgrades[key] = data.Upgrades[key] or 0
	end
	local missions = {}
	for key, mission in pairs(data.Missions) do
		missions[key] = { Level = mission.Level, Progress = mission.Progress }
	end
	return {
		Speed = data.Speed,
		Coins = data.Coins,
		Rebirths = data.Rebirths,
		Checkpoint = data.Checkpoint,
		Best = data.Best or 0,
		Upgrades = upgrades,
		Missions = missions,
	}
end

local function notify(player, message)
	Notify:FireClient(player, message)
end

local function updateBest(data)
	if data.Speed > (data.Best or 0) then
		data.Best = data.Speed
	end
end

local function currentCombo(player)
	local state = comboState[player]
	if not state then
		return 0
	end
	if os.clock() - state.Last > Config.ComboWindow then
		return 0
	end
	return state.Count
end

local function hasPass(player, key)
	local id = Config.PassIds[key]
	if not id or id == 0 then
		return false
	end
	local cached = passCache[player]
	if cached and cached[key] ~= nil then
		return cached[key]
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
	end)
	owns = ok and owns == true
	passCache[player] = cached or {}
	passCache[player][key] = owns
	return owns
end

local function passOwned(player, key)
	local cached = passCache[player]
	return cached ~= nil and cached[key] == true
end

local function coinMultiplier(player, data)
	local multiplier = 1 + data.Rebirths * Config.RebirthCoinBonus
	multiplier *= 1 + data.Upgrades.Coins * Config.Upgrades.Coins.Effect
	if passOwned(player, "DoubleCoins") then
		multiplier *= 2
	end
	return multiplier
end

local function applyHumanoid(player, data)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = Config.GetWalkSpeed(
		data.Speed,
		data.Rebirths,
		data.Upgrades.Speed,
		passOwned(player, "DoubleSpeed")
	)
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 50 + data.Upgrades.Jump * Config.Upgrades.Jump.Effect
end

local function respawnCFrame(index)
	if index and index > 0 and checkpoints[index] then
		return checkpoints[index].CFrame + Vector3.new(0, 6, 0)
	end
	return spawnLocation.CFrame + Vector3.new(0, 5, 0)
end

local function teleportToCheckpoint(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local target = respawnCFrame(data.Checkpoint)
	character:PivotTo(CFrame.lookAt(target.Position, target.Position + Vector3.new(0, 0, -1)))
	root.AssemblyLinearVelocity = Vector3.zero
end

local function setupCharacter(player, character)
	task.wait(0.15)
	if player.Character ~= character then
		return
	end
	teleportToCheckpoint(player)
end

local function checkMissions(player, data, key)
	local mission = data.Missions[key]
	local definition = Config.Missions[key]
	if not mission or not definition then
		return
	end
	local completed = false
	for _ = 1, 25 do
		local target = Config.GetMissionTarget(key, mission.Level)
		if mission.Progress < target then
			break
		end
		local reward = Config.GetMissionReward(key, mission.Level)
		mission.Progress -= target
		mission.Level += 1
		data.Coins += reward
		completed = true
		notify(player, string.format("MISION: %s %d. +%d monedas.", definition.Label, mission.Level, reward))
		FX:FireClient(player, "Mision")
	end
	if completed then
		SyncState:FireClient(player, snapshot(data))
	end
end

local function setupLeaderstats(player, data)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local speed = Instance.new("IntValue")
	speed.Name = "Speed"
	speed.Value = math.floor(data.Speed)

	local coinsValue = Instance.new("IntValue")
	coinsValue.Name = "Coins"
	coinsValue.Value = math.floor(data.Coins)

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = data.Rebirths

	local best = Instance.new("IntValue")
	best.Name = "Best"
	best.Value = math.floor(data.Best or 0)

	speed.Parent = folder
	coinsValue.Parent = folder
	rebirths.Parent = folder
	best.Parent = folder
	folder.Parent = player
end

local function onPlayerAdded(player)
	if player:GetAttribute("SpeedEscapeLoaded") then
		return
	end
	player:SetAttribute("SpeedEscapeLoaded", true)

	local data = DataService.Load(player)
	if not player.Parent then
		DataService.Release(player)
		return
	end

	updateBest(data)
	setupLeaderstats(player, data)
	SyncState:FireClient(player, snapshot(data))
	notify(player, "Presiona teclas para +1 velocidad. Corre con WASD.")

	task.spawn(function()
		hasPass(player, "DoubleSpeed")
		hasPass(player, "DoubleCoins")
	end)

	player.CharacterAdded:Connect(function(character)
		task.spawn(setupCharacter, player, character)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(function(player)
	task.spawn(onPlayerAdded, player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

AddSpeed.OnServerEvent:Connect(function(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local now = os.clock()
	local bucket = keyBuckets[player]
	if not bucket then
		bucket = { tokens = Config.KeyRateLimit, last = now }
		keyBuckets[player] = bucket
	end
	bucket.tokens = math.min(Config.KeyRateLimit, bucket.tokens + (now - bucket.last) * Config.KeyRateLimit)
	bucket.last = now
	if bucket.tokens < 1 then
		return
	end
	bucket.tokens -= 1

	local combo = comboState[player]
	if not combo then
		combo = { Count = 0, Last = 0 }
		comboState[player] = combo
	end
	if now - combo.Last <= Config.ComboWindow then
		combo.Count = math.min(Config.ComboMax, combo.Count + 1)
	else
		combo.Count = 1
	end
	combo.Last = now

	data.Speed += 1
	updateBest(data)
	data.Missions.Keys.Progress += 1
	checkMissions(player, data, "Keys")
end)

GetState.OnServerInvoke = function(player)
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	return snapshot(data)
end

Rebirth.OnServerEvent:Connect(function(player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	if data.Speed < Config.RebirthRequirement then
		notify(player, string.format(
			"Necesitas %d de velocidad para renacer. Tienes %d.",
			Config.RebirthRequirement,
			math.floor(data.Speed)
		))
		return
	end
	data.Rebirths += 1
	data.Speed = 0
	data.Checkpoint = 0
	local combo = comboState[player]
	if combo then
		combo.Count = 0
	end
	teleportToCheckpoint(player)
	SyncState:FireClient(player, snapshot(data))
	FX:FireClient(player, "Renacer")
	notify(player, string.format(
		"RENACIMIENTO %d. Bonus: +%d%% velocidad y monedas.",
		data.Rebirths,
		math.floor(data.Rebirths * Config.RebirthSpeedBonus * 100)
	))
end)

BuyUpgrade.OnServerEvent:Connect(function(player, upgradeKey)
	if type(upgradeKey) ~= "string" then
		return
	end
	local data = DataService.Get(player)
	if not data then
		return
	end
	local upgrade = Config.Upgrades[upgradeKey]
	if not upgrade then
		return
	end
	local level = data.Upgrades[upgradeKey] or 0
	if level >= upgrade.MaxLevel then
		notify(player, "Esa mejora ya esta al maximo.")
		return
	end
	local cost = Config.GetUpgradeCost(upgradeKey, level)
	if data.Coins < cost then
		notify(player, string.format("Te faltan %d monedas.", cost - data.Coins))
		return
	end
	data.Coins -= cost
	data.Upgrades[upgradeKey] = level + 1
	SyncState:FireClient(player, snapshot(data))
	notify(player, string.format("%s al nivel %d.", upgrade.Label, level + 1))
end)

for index, part in ipairs(checkpoints) do
	part.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player then
			return
		end
		local data = DataService.Get(player)
		if not data or index <= data.Checkpoint then
			return
		end
		data.Checkpoint = index
		data.Speed += Config.CheckpointSpeedBonus
		updateBest(data)
		local reward = math.floor(
			Config.CheckpointCoinBase
				* index
				* coinMultiplier(player, data)
				* Config.GetComboMultiplier(currentCombo(player))
		)
		data.Coins += reward
		data.Missions.Checkpoint.Progress += 1
		notify(player, string.format(
			"Checkpoint %d/%d. +%d monedas, +%d velocidad.",
			index,
			Config.CheckpointCount,
			reward,
			Config.CheckpointSpeedBonus
		))
		FX:FireClient(player, "Checkpoint", index)
		checkMissions(player, data, "Checkpoint")
		SyncState:FireClient(player, snapshot(data))
	end)
end

local function collectCoin(player, data, entry)
	local part = entry.Part
	if not part or not part.Parent or not part.CanTouch then
		return
	end
	part.CanTouch = false
	part.Transparency = 1
	local multiplier = coinMultiplier(player, data) * Config.GetComboMultiplier(currentCombo(player))
	local amount = math.max(1, math.floor(entry.Value * multiplier))
	data.Coins += amount
	data.Missions.Coins.Progress += amount
	notify(player, string.format("+%d monedas", amount))
	FX:FireClient(player, "Moneda")
	checkMissions(player, data, "Coins")
	SyncState:FireClient(player, snapshot(data))
	task.delay(Config.CoinRespawn, function()
		if part.Parent then
			part.Transparency = 0
			part.CanTouch = true
		end
	end)
end

for _, entry in ipairs(coins) do
	entry.Part.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player then
			return
		end
		local data = DataService.Get(player)
		if not data then
			return
		end
		collectCoin(player, data, entry)
	end)
end

-- Iman: recoge monedas cercanas automaticamente.
task.spawn(function()
	while true do
		task.wait(0.25)
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.Get(player)
			local level = data and data.Upgrades.Magnet or 0
			if level > 0 then
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root then
					local radius = Config.MagnetBase + level * Config.Upgrades.Magnet.Effect
					for _, entry in ipairs(coins) do
						if entry.Part.CanTouch and (root.Position - entry.Part.Position).Magnitude <= radius then
							collectCoin(player, data, entry)
						end
					end
				end
			end
		end
	end
end)

for _, pad in ipairs(mapData.boostPads) do
	pad.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player then
			return
		end
		local data = DataService.Get(player)
		if not data then
			return
		end
		local now = os.clock()
		if (boostCooldowns[player] or 0) > now then
			return
		end
		boostCooldowns[player] = now + Config.BoostCooldown
		data.Speed += Config.BoostAmount
		updateBest(data)
		notify(player, string.format("BOOST. +%d velocidad.", Config.BoostAmount))
		FX:FireClient(player, "Boost")
	end)
end

local function connectHazard(part)
	part.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player then
			return
		end
		local data = DataService.Get(player)
		if not data then
			return
		end
		local now = os.clock()
		if (obstacleCooldowns[player] or 0) > now then
			return
		end
		obstacleCooldowns[player] = now + Config.ObstacleCooldown
		local lost = math.floor(data.Speed * Config.ObstaclePenalty)
		if lost <= 0 then
			return
		end
		data.Speed = math.max(0, data.Speed - lost)
		notify(player, string.format("CHOQUE. -%d velocidad.", lost))
		FX:FireClient(player, "Choque")
	end)
end

for _, obstacle in ipairs(mapData.obstacles) do
	connectHazard(obstacle)
end
for _, sweeper in ipairs(mapData.sweepers) do
	connectHazard(sweeper.Part)
end

mapData.finishTrigger.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if not player then
		return
	end
	local data = DataService.Get(player)
	if not data then
		return
	end
	local now = os.clock()
	if (finishCooldowns[player] or 0) > now then
		return
	end
	finishCooldowns[player] = now + 3
	local reward = math.floor(
		Config.FinishReward
			* coinMultiplier(player, data)
			* Config.GetComboMultiplier(currentCombo(player))
	)
	data.Coins += reward
	data.Checkpoint = 0
	local combo = comboState[player]
	if combo then
		combo.Count = 0
	end
	teleportToCheckpoint(player)
	notify(player, string.format("META. +%d monedas. Vuelve a correr.", reward))
	FX:FireClient(player, "Meta")
	SyncState:FireClient(player, snapshot(data))
end)

mapData.voidPlane.Touched:Connect(function(hit)
	local player = Players:GetPlayerFromCharacter(hit.Parent)
	if not player then
		return
	end
	teleportToCheckpoint(player)
end)

-- Ranking de la partida (los mejores records de los jugadores conectados).
local function sessionLeaderboard()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local data = DataService.Get(player)
		if data then
			table.insert(list, {
				Name = player.Name,
				DisplayName = player.DisplayName,
				Value = math.floor(data.Best or 0),
			})
		end
	end
	table.sort(list, function(a, b)
		if a.Value == b.Value then
			return a.Name < b.Name
		end
		return a.Value > b.Value
	end)
	local top = {}
	for index = 1, math.min(#list, 10) do
		top[index] = list[index]
	end
	return top
end

task.spawn(function()
	while true do
		Leaderboard:FireAllClients(sessionLeaderboard())
		task.wait(5)
	end
end)

-- Auto-velocidad pasiva.
task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.Get(player)
			if data then
				local level = data.Upgrades.Auto or 0
				if level > 0 then
					data.Speed += level * Config.Upgrades.Auto.Effect
					updateBest(data)
				end
			end
		end
	end
end)

-- Sincronizacion de stats, velocidad fisica y combo.
task.spawn(function()
	while true do
		task.wait(0.1)
		local now = os.clock()
		for _, player in ipairs(Players:GetPlayers()) do
			local data = DataService.Get(player)
			if data then
				updateBest(data)
				local combo = comboState[player]
				if combo and combo.Count > 0 and now - combo.Last > Config.ComboWindow then
					combo.Count = 0
				end
				local stats = player:FindFirstChild("leaderstats")
				if stats then
					stats.Speed.Value = math.floor(data.Speed)
					stats.Coins.Value = math.floor(data.Coins)
					stats.Rebirths.Value = data.Rebirths
					stats.Best.Value = math.floor(data.Best or 0)
				end
				applyHumanoid(player, data)
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(DataService.Save, player)
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	DataService.Save(player)
	DataService.Release(player)
	passCache[player] = nil
	keyBuckets[player] = nil
	comboState[player] = nil
	boostCooldowns[player] = nil
	obstacleCooldowns[player] = nil
	finishCooldowns[player] = nil
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		DataService.Save(player)
	end
	task.wait(1)
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="13">
      <Properties>
        <string name="Name">MapBuilder</string>
        <string name="Source"><![CDATA[-- Construye la pista completa por codigo al iniciar el servidor.
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapBuilder = {}

local DANGER_COLOR = Color3.fromRGB(255, 70, 80)
local COIN_COLOR = Color3.fromRGB(255, 210, 50)
local BOOST_COLOR = Color3.fromRGB(255, 220, 70)
local FINISH_COLOR = Color3.fromRGB(80, 220, 255)

local function makePart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	part.CanCollide = true
	for key, value in pairs(props) do
		if key ~= "Parent" then
			part[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

local function ensureEffect(className, name)
	local effect = Lighting:FindFirstChild(name)
	if not effect then
		effect = Instance.new(className)
		effect.Name = name
		effect.Parent = Lighting
	end
	return effect
end

local function clearOld()
	local old = Workspace:FindFirstChild("SpeedEscapeMap")
	if old then
		old:Destroy()
	end
	local oldSpawn = Workspace:FindFirstChild("SpeedEscapeSpawn")
	if oldSpawn then
		oldSpawn:Destroy()
	end
	local baseplate = Workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		baseplate:Destroy()
	end
	local defaultSpawn = Workspace:FindFirstChild("SpawnLocation")
	if defaultSpawn and defaultSpawn:IsA("SpawnLocation") then
		defaultSpawn:Destroy()
	end
end

local function addBillboard(adornee, text, color, offsetY, width, height)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Adornee = adornee
	billboard.Size = UDim2.fromOffset(width or 260, height or 54)
	billboard.StudsOffset = Vector3.new(0, offsetY or 7, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 900
	billboard.Parent = adornee

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Parent = billboard
end

local function zoneAtZ(z)
	local index = math.clamp(math.floor((-z) / Config.ZoneLength) + 1, 1, #Config.Zones)
	return Config.Zones[index], index
end

local function isClear(z, list, minDistance)
	for _, other in ipairs(list) do
		if math.abs(z - other) < minDistance then
			return false
		end
	end
	return true
end

function MapBuilder.Build()
	clearOld()

	local map = Instance.new("Folder")
	map.Name = "SpeedEscapeMap"

	local track = Instance.new("Folder")
	track.Name = "Track"
	track.Parent = map

	local hazards = Instance.new("Folder")
	hazards.Name = "Hazards"
	hazards.Parent = map

	local checkpointsFolder = Instance.new("Folder")
	checkpointsFolder.Name = "Checkpoints"
	checkpointsFolder.Parent = map

	local effects = Instance.new("Folder")
	effects.Name = "Effects"
	effects.Parent = map

	local coinsFolder = Instance.new("Folder")
	coinsFolder.Name = "Coins"
	coinsFolder.Parent = map

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = map

	-- Spawn directo en Workspace (los SpawnLocation dentro de carpetas no siempre funcionan).
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpeedEscapeSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(34, 1, 40)
	spawn.CFrame = CFrame.new(0, 0.5, 20)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Color = Color3.fromRGB(40, 52, 90)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = Workspace

	-- Suelo por zonas.
	local segmentLength = 20
	local segmentCount = math.ceil(Config.TrackLength / segmentLength)
	for i = 0, segmentCount - 1 do
		local z = -(i * segmentLength) - segmentLength / 2
		local zone = zoneAtZ(z)
		makePart({
			Name = "Floor_" .. i,
			Size = Vector3.new(Config.TrackWidth, 2, segmentLength),
			CFrame = CFrame.new(0, 0, z),
			Color = (i % 2 == 0) and zone.FloorA or zone.FloorB,
			Parent = track,
		})
	end

	-- Rieles neon en los bordes de cada zona.
	for zoneIndex = 1, #Config.Zones do
		local zone = Config.Zones[zoneIndex]
		local centerZ = -((zoneIndex - 1) * Config.ZoneLength + Config.ZoneLength / 2)
		for _, x in ipairs({ -Config.TrackWidth / 2 - 0.8, Config.TrackWidth / 2 + 0.8 }) do
			makePart({
				Name = "Rail",
				Size = Vector3.new(1.2, 0.5, Config.ZoneLength),
				CFrame = CFrame.new(x, 1.4, centerZ),
				Color = zone.Accent,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = decor,
			})
		end
	end

	-- Titulo en la salida.
	local startLeft = makePart({
		Name = "StartPillar",
		Size = Vector3.new(3, 18, 3),
		CFrame = CFrame.new(-20, 9, 12),
		Color = Color3.fromRGB(80, 220, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = decor,
	})
	makePart({
		Name = "StartPillar",
		Size = Vector3.new(3, 18, 3),
		CFrame = CFrame.new(20, 9, 12),
		Color = Color3.fromRGB(80, 220, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = decor,
	})
	local startTop = makePart({
		Name = "StartTop",
		Size = Vector3.new(43, 3, 3),
		CFrame = CFrame.new(0, 18, 12),
		Color = Color3.fromRGB(80, 220, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = decor,
	})
	addBillboard(startTop, "SPEED ESCAPE", Color3.fromRGB(240, 250, 255), 4, 420, 70)
	addBillboard(startLeft, "SPAMEA TECLAS", Color3.fromRGB(150, 230, 255), 4, 240, 40)

	local checkpoints = {}
	local reserved = {}

	-- Checkpoints.
	for i = 1, Config.CheckpointCount do
		local z = -i * Config.CheckpointSpacing
		local zone = zoneAtZ(z)
		local strip = makePart({
			Name = "Checkpoint_" .. i,
			Size = Vector3.new(Config.TrackWidth, 0.4, 8),
			CFrame = CFrame.new(0, 1.2, z),
			Color = zone.Accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = checkpointsFolder,
		})
		strip:SetAttribute("CheckpointIndex", i)
		addBillboard(strip, "CHECKPOINT " .. i, zone.Accent, 7, 240, 48)
		checkpoints[i] = strip
		table.insert(reserved, z)
	end

	-- Arcos de zona.
	for zoneIndex = 2, #Config.Zones do
		local zone = Config.Zones[zoneIndex]
		local z = -((zoneIndex - 1) * Config.ZoneLength)
		for _, x in ipairs({ -23.5, 23.5 }) do
			makePart({
				Name = "ZonePillar",
				Size = Vector3.new(2.5, 16, 2.5),
				CFrame = CFrame.new(x, 8, z),
				Color = zone.Accent,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = decor,
			})
		end
		local top = makePart({
			Name = "ZoneTop",
			Size = Vector3.new(50, 2.5, 2.5),
			CFrame = CFrame.new(0, 16, z),
			Color = zone.Accent,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = decor,
		})
		addBillboard(top, zoneIndex .. ". " .. zone.Name, zone.Accent, 4, 460, 60)
	end

	local lanes = { -16.5, -5.5, 5.5, 16.5 }
	local rng = Random.new(20261103)

	-- Plataformas de impulso.
	local boostPads = {}
	local boostZ = -300
	while boostZ > -Config.TrackLength + 100 do
		local lane = lanes[rng:NextInteger(1, #lanes)]
		local pad = makePart({
			Name = "BoostPad",
			Size = Vector3.new(10, 0.5, 10),
			CFrame = CFrame.new(lane, 1.2, boostZ),
			Color = BOOST_COLOR,
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = effects,
		})
		pad:SetAttribute("BoostPad", true)
		table.insert(boostPads, pad)
		table.insert(reserved, boostZ)
		boostZ -= 600
	end

	-- Obstaculos moviles: barras que giran y se saltan.
	local sweepers = {}
	for zoneIndex = 2, #Config.Zones do
		local z = -((zoneIndex - 1) * Config.ZoneLength) - 250
		local bar = makePart({
			Name = "Sweeper",
			Size = Vector3.new(Config.TrackWidth + 4, 1.4, 1.4),
			CFrame = CFrame.new(0, 3, z),
			Color = DANGER_COLOR,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanTouch = true,
			Parent = hazards,
		})
		bar:SetAttribute("Sweeper", true)
		makePart({
			Name = "SweeperCore",
			Size = Vector3.new(2.4, 2.4, 2.4),
			CFrame = CFrame.new(0, 3, z),
			Color = Color3.fromRGB(255, 160, 80),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanTouch = false,
			Parent = decor,
		})
		table.insert(sweepers, {
			Part = bar,
			Position = Vector3.new(0, 3, z),
			Speed = 0.85 + zoneIndex * 0.08,
			Angle = zoneIndex,
		})
		table.insert(reserved, z)
	end

	-- Obstaculos fijos.
	local obstacles = {}
	local z = -180
	while z > -Config.TrackLength + 200 do
		if isClear(z, reserved, 55) then
			local laneCount = rng:NextInteger(1, 2)
			local picked = {}
			local used = {}
			while #picked < laneCount do
				local lane = rng:NextInteger(1, #lanes)
				if not used[lane] then
					used[lane] = true
					table.insert(picked, lane)
				end
			end
			for _, lane in ipairs(picked) do
				local obstacle = makePart({
					Name = "Obstacle",
					Size = Vector3.new(9.5, 12, 6),
					CFrame = CFrame.new(lanes[lane], 7, z),
					Color = DANGER_COLOR,
					Material = Enum.Material.Neon,
					Parent = hazards,
				})
				table.insert(obstacles, obstacle)
			end
			table.insert(reserved, z)
		end
		z -= rng:NextNumber(120, 190)
	end

	-- Monedas coleccionables.
	local coins = {}
	for zoneIndex = 1, #Config.Zones do
		local zoneStart = -((zoneIndex - 1) * Config.ZoneLength)
		for _ = 1, Config.CoinPerZone do
			for _ = 1, 24 do
				local coinZ = zoneStart - rng:NextNumber(60, Config.ZoneLength - 60)
				if isClear(coinZ, reserved, 28) then
					local lane = lanes[rng:NextInteger(1, #lanes)]
					local position = Vector3.new(lane, 2.4, coinZ)
					local coin = Instance.new("Part")
					coin.Name = "Coin"
					coin.Shape = Enum.PartType.Cylinder
					coin.Size = Vector3.new(0.5, 4.5, 4.5)
					coin.CFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(90), 0)
					coin.Anchored = true
					coin.CanCollide = false
					coin.CanTouch = true
					coin.Material = Enum.Material.Neon
					coin.Color = COIN_COLOR
					coin.Parent = coinsFolder
					table.insert(coins, {
						Part = coin,
						Value = Config.CoinValue + (zoneIndex - 1) * 5,
						Position = position,
					})
					table.insert(reserved, coinZ)
					break
				end
			end
		end
	end

	-- Meta.
	local finishZ = -Config.TrackLength
	for _, x in ipairs({ -22, 22 }) do
		makePart({
			Name = "FinishPillar",
			Size = Vector3.new(4, 24, 4),
			CFrame = CFrame.new(x, 13, finishZ),
			Color = FINISH_COLOR,
			Material = Enum.Material.Neon,
			Parent = effects,
		})
	end
	makePart({
		Name = "FinishTop",
		Size = Vector3.new(48, 4, 4),
		CFrame = CFrame.new(0, 27, finishZ),
		Color = FINISH_COLOR,
		Material = Enum.Material.Neon,
		Parent = effects,
	})
	local gate = makePart({
		Name = "FinishGate",
		Size = Vector3.new(Config.TrackWidth, 24, 1),
		CFrame = CFrame.new(0, 13, finishZ),
		Color = FINISH_COLOR,
		Material = Enum.Material.ForceField,
		Transparency = 0.55,
		CanCollide = false,
		CanTouch = false,
		Parent = effects,
	})
	addBillboard(gate, "META", FINISH_COLOR, 6, 300, 70)

	local finishTrigger = makePart({
		Name = "FinishTrigger",
		Size = Vector3.new(Config.TrackWidth, 24, 12),
		CFrame = CFrame.new(0, 13, finishZ),
		Transparency = 1,
		CanCollide = false,
		CanTouch = true,
		Parent = effects,
	})

	local voidPlane = makePart({
		Name = "VoidPlane",
		Size = Vector3.new(500, 24, Config.TrackLength + 400),
		CFrame = CFrame.new(0, -40, -Config.TrackLength / 2),
		Transparency = 1,
		CanCollide = false,
		CanTouch = true,
		Parent = effects,
	})

	-- Iluminacion y post-procesado.
	Lighting.ClockTime = 18.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(60, 65, 92)
	Lighting.OutdoorAmbient = Color3.fromRGB(85, 92, 130)
	Lighting.FogStart = 900
	Lighting.FogEnd = 2800
	Lighting.FogColor = Color3.fromRGB(105, 125, 170)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.35

	local atmosphere = ensureEffect("Atmosphere", "SpeedEscapeAtmosphere")
	atmosphere.Density = 0.32
	atmosphere.Haze = 1.4
	atmosphere.Glare = 0
	atmosphere.Color = Color3.fromRGB(140, 170, 220)
	atmosphere.Decay = Color3.fromRGB(80, 100, 150)

	local bloom = ensureEffect("BloomEffect", "SpeedEscapeBloom")
	bloom.Intensity = 0.9
	bloom.Size = 26
	bloom.Threshold = 1.1

	local correction = ensureEffect("ColorCorrectionEffect", "SpeedEscapeColor")
	correction.Saturation = 0.18
	correction.Contrast = 0.08
	correction.Brightness = 0

	local rays = ensureEffect("SunRaysEffect", "SpeedEscapeRays")
	rays.Intensity = 0.05
	rays.Spread = 0.5

	map.Parent = Workspace

	-- Animacion: monedas girando y barras barriendo.
	task.spawn(function()
		local elapsed = 0
		while true do
			elapsed += task.wait(0.1)
			for _, entry in ipairs(coins) do
				local coin = entry.Part
				if coin.Parent and coin.CanTouch then
					local bob = math.sin(elapsed * 2 + entry.Position.Z * 0.05) * 0.25
					coin.CFrame = CFrame.new(entry.Position + Vector3.new(0, bob, 0))
						* CFrame.Angles(0, elapsed * 2.2 + entry.Position.Z * 0.1, 0)
						* CFrame.Angles(0, math.rad(90), 0)
				end
			end
		end
	end)

	task.spawn(function()
		while true do
			local deltaTime = task.wait(1 / 30)
			for _, sweeper in ipairs(sweepers) do
				if sweeper.Part.Parent then
					sweeper.Angle += deltaTime * sweeper.Speed
					sweeper.Part.CFrame = CFrame.new(sweeper.Position) * CFrame.Angles(0, sweeper.Angle, 0)
				end
			end
		end
	end)

	return {
		spawn = spawn,
		checkpoints = checkpoints,
		obstacles = obstacles,
		boostPads = boostPads,
		sweepers = sweepers,
		coins = coins,
		finishTrigger = finishTrigger,
		voidPlane = voidPlane,
		finishZ = finishZ,
	}
end

return MapBuilder
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="14">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="15">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="16">
        <Properties>
          <string name="Name">InputController</string>
          <string name="Source"><![CDATA[-- Envia +1 velocidad al servidor con cada tecla pulsada (con limite local).
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local AddSpeed = Remotes:WaitForChild("AddSpeed")

local MIN_INTERVAL = 1 / 30
local lastSent = 0

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local now = os.clock()
	if now - lastSent < MIN_INTERVAL then
		return
	end
	lastSent = now
	AddSpeed:FireServer()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="17">
        <Properties>
          <string name="Name">UIController</string>
          <string name="Source"><![CDATA[-- HUD, tienda, boton de renacimiento, avisos y progreso.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local BuyUpgrade = Remotes:WaitForChild("BuyUpgrade")
local Rebirth = Remotes:WaitForChild("Rebirth")
local GetState = Remotes:WaitForChild("GetState")
local SyncState = Remotes:WaitForChild("SyncState")
local Notify = Remotes:WaitForChild("Notify")

local COLORS = {
	bg = Color3.fromRGB(14, 16, 28),
	panel = Color3.fromRGB(24, 28, 48),
	panelLight = Color3.fromRGB(38, 44, 70),
	accent = Color3.fromRGB(80, 220, 255),
	green = Color3.fromRGB(80, 255, 150),
	yellow = Color3.fromRGB(255, 215, 60),
	red = Color3.fromRGB(255, 90, 90),
	text = Color3.fromRGB(240, 244, 255),
	muted = Color3.fromRGB(150, 160, 190),
}
local FONT_BOLD = Enum.Font.GothamBold
local FONT_BLACK = Enum.Font.GothamBlack

local function create(className, props)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	instance.Parent = props.Parent
	return instance
end

local function corner(parent, radius)
	local item = Instance.new("UICorner")
	item.CornerRadius = UDim.new(0, radius or 8)
	item.Parent = parent
end

local function stroke(parent, color, thickness, transparency)
	local item = Instance.new("UIStroke")
	item.Color = color or COLORS.accent
	item.Thickness = thickness or 2
	item.Transparency = transparency or 0
	item.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	item.Parent = parent
end

local function comma(number)
	local text = tostring(math.floor(number))
	local count
	repeat
		text, count = text:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
	until count == 0
	return text
end

local function short(number)
	number = math.floor(number)
	if number >= 1e9 then
		return string.format("%.1fB", number / 1e9)
	elseif number >= 1e6 then
		return string.format("%.1fM", number / 1e6)
	elseif number >= 1e3 then
		return string.format("%.1fK", number / 1e3)
	end
	return tostring(number)
end

local screenGui = create("ScreenGui", {
	Name = "SpeedEscapeHUD",
	IgnoreGuiInset = false,
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})

-- Velocidad (centro superior).
local speedFrame = create("Frame", {
	Name = "SpeedFrame",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 16),
	Size = UDim2.fromOffset(320, 96),
	BackgroundColor3 = COLORS.bg,
	BackgroundTransparency = 0.12,
	Parent = screenGui,
})
corner(speedFrame, 16)
stroke(speedFrame, COLORS.accent, 2, 0.35)

create("TextLabel", {
	Position = UDim2.fromOffset(0, 8),
	Size = UDim2.new(1, 0, 0, 20),
	BackgroundTransparency = 1,
	Text = "VELOCIDAD",
	TextColor3 = COLORS.muted,
	Font = FONT_BOLD,
	TextSize = 15,
	Parent = speedFrame,
})

local speedValue = create("TextLabel", {
	Position = UDim2.fromOffset(0, 24),
	Size = UDim2.new(1, 0, 0, 56),
	BackgroundTransparency = 1,
	Text = "0",
	TextColor3 = COLORS.text,
	Font = FONT_BLACK,
	TextSize = 46,
	Parent = speedFrame,
})

-- Barra de progreso.
local progressBackground = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 120),
	Size = UDim2.fromOffset(320, 12),
	BackgroundColor3 = COLORS.panel,
	BorderSizePixel = 0,
	Parent = screenGui,
})
corner(progressBackground, 6)
stroke(progressBackground, COLORS.panelLight, 1, 0.2)

local progressFill = create("Frame", {
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = COLORS.accent,
	BorderSizePixel = 0,
	Parent = progressBackground,
})
corner(progressFill, 6)

-- Monedas y renacimientos (izquierda).
local statsFrame = create("Frame", {
	Position = UDim2.fromOffset(16, 16),
	Size = UDim2.fromOffset(240, 82),
	BackgroundColor3 = COLORS.bg,
	BackgroundTransparency = 0.12,
	Parent = screenGui,
})
corner(statsFrame, 14)
stroke(statsFrame, COLORS.panelLight, 2, 0.2)

local function statBlock(parent, offsetX, title, color)
	create("TextLabel", {
		Position = UDim2.fromOffset(offsetX, 10),
		Size = UDim2.fromOffset(104, 18),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = COLORS.muted,
		Font = FONT_BOLD,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
	return create("TextLabel", {
		Position = UDim2.fromOffset(offsetX, 30),
		Size = UDim2.fromOffset(104, 38),
		BackgroundTransparency = 1,
		Text = "0",
		TextColor3 = color,
		Font = FONT_BLACK,
		TextSize = 27,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = parent,
	})
end

local coinsValue = statBlock(statsFrame, 16, "MONEDAS", COLORS.yellow)
local rebirthsValue = statBlock(statsFrame, 126, "RENACERES", COLORS.green)

-- Pista de ayuda.
local hint = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -22),
	Size = UDim2.fromOffset(620, 28),
	BackgroundTransparency = 1,
	Text = "WASD para correr  |  Cualquier tecla = +1 VELOCIDAD",
	TextColor3 = COLORS.muted,
	Font = FONT_BOLD,
	TextSize = 18,
	Parent = screenGui,
})

-- Botones inferiores derechos.
local shopButton = create("TextButton", {
	Name = "ShopButton",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -20, 1, -22),
	Size = UDim2.fromOffset(180, 48),
	BackgroundColor3 = COLORS.accent,
	Text = "TIENDA",
	TextColor3 = COLORS.bg,
	Font = FONT_BLACK,
	TextSize = 20,
	Parent = screenGui,
})
corner(shopButton, 12)

local rebirthButton = create("TextButton", {
	Name = "RebirthButton",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -20, 1, -82),
	Size = UDim2.fromOffset(180, 48),
	BackgroundColor3 = COLORS.panelLight,
	Text = "RENACER",
	TextColor3 = COLORS.muted,
	Font = FONT_BLACK,
	TextSize = 17,
	Parent = screenGui,
})
corner(rebirthButton, 12)
stroke(rebirthButton, COLORS.green, 2, 0.55)

-- Fondo oscuro del panel.
local dimmer = create("TextButton", {
	Name = "Dimmer",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.5,
	Text = "",
	AutoButtonColor = false,
	Visible = false,
	ZIndex = 10,
	Parent = screenGui,
})

-- Panel de tienda.
local shopPanel = create("Frame", {
	Name = "ShopPanel",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(470, 380),
	BackgroundColor3 = COLORS.bg,
	Visible = false,
	ZIndex = 11,
	Parent = screenGui,
})
corner(shopPanel, 18)
stroke(shopPanel, COLORS.accent, 2, 0.2)

create("TextLabel", {
	Position = UDim2.fromOffset(20, 16),
	Size = UDim2.fromOffset(300, 28),
	BackgroundTransparency = 1,
	Text = "MEJORAS",
	TextColor3 = COLORS.text,
	Font = FONT_BLACK,
	TextSize = 22,
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = shopPanel,
})

local closeButton = create("TextButton", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 12),
	Size = UDim2.fromOffset(36, 36),
	BackgroundColor3 = COLORS.panelLight,
	Text = "X",
	TextColor3 = COLORS.text,
	Font = FONT_BLACK,
	TextSize = 18,
	Parent = shopPanel,
})
corner(closeButton, 8)

local upgradeRows = {}
local rowOrder = { "Speed", "Coins", "Jump" }

for index, key in ipairs(rowOrder) do
	local upgrade = Config.Upgrades[key]
	local row = create("Frame", {
		Name = key .. "Row",
		Position = UDim2.fromOffset(16, 60 + (index - 1) * 94),
		Size = UDim2.new(1, -32, 0, 82),
		BackgroundColor3 = COLORS.panel,
		BorderSizePixel = 0,
		Parent = shopPanel,
	})
	corner(row, 12)

	create("TextLabel", {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.fromOffset(230, 26),
		BackgroundTransparency = 1,
		Text = upgrade.Label,
		TextColor3 = COLORS.text,
		Font = FONT_BLACK,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local levelLabel = create("TextLabel", {
		Position = UDim2.fromOffset(14, 36),
		Size = UDim2.fromOffset(230, 18),
		BackgroundTransparency = 1,
		Text = "Nivel 0 / " .. upgrade.MaxLevel,
		TextColor3 = COLORS.muted,
		Font = FONT_BOLD,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local effectLabel = create("TextLabel", {
		Position = UDim2.fromOffset(14, 56),
		Size = UDim2.fromOffset(230, 18),
		BackgroundTransparency = 1,
		Text = "",
		TextColor3 = COLORS.muted,
		Font = FONT_BOLD,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})

	local buyButton = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(150, 46),
		BackgroundColor3 = COLORS.green,
		Text = "Comprar",
		TextColor3 = COLORS.bg,
		Font = FONT_BLACK,
		TextSize = 15,
		Parent = row,
	})
	corner(buyButton, 10)

	buyButton.Activated:Connect(function()
		BuyUpgrade:FireServer(key)
	end)

	upgradeRows[key] = {
		level = levelLabel,
		effect = effectLabel,
		buy = buyButton,
	}
end

-- Aviso flotante.
local toastFrame = create("Frame", {
	Name = "Toast",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 150),
	Size = UDim2.fromOffset(480, 44),
	BackgroundColor3 = COLORS.panel,
	BackgroundTransparency = 0.05,
	Visible = false,
	ZIndex = 20,
	Parent = screenGui,
})
corner(toastFrame, 10)
stroke(toastFrame, COLORS.accent, 1, 0.35)

local toastLabel = create("TextLabel", {
	Position = UDim2.fromOffset(12, 0),
	Size = UDim2.new(1, -24, 1, 0),
	BackgroundTransparency = 1,
	Text = "",
	TextColor3 = COLORS.text,
	Font = FONT_BOLD,
	TextSize = 15,
	TextWrapped = true,
	Parent = toastFrame,
})

local toastToken = 0
local function showToast(message)
	toastToken += 1
	local token = toastToken
	toastLabel.Text = message
	toastFrame.Visible = true
	toastFrame.BackgroundTransparency = 0.05
	toastFrame.Position = UDim2.new(0.5, 0, 0, 142)
	TweenService:Create(toastFrame, TweenInfo.new(0.18), {
		Position = UDim2.new(0.5, 0, 0, 150),
	}):Play()
	task.delay(3, function()
		if token ~= toastToken then
			return
		end
		TweenService:Create(toastFrame, TweenInfo.new(0.25), {
			Position = UDim2.new(0.5, 0, 0, 138),
			BackgroundTransparency = 1,
		}):Play()
		task.wait(0.25)
		if token == toastToken then
			toastFrame.Visible = false
			toastFrame.BackgroundTransparency = 0.05
		end
	end)
end

-- Estado y tienda.
local state = nil
local shopOpen = false

local leaderstats = player:WaitForChild("leaderstats")
local speedStat = leaderstats:WaitForChild("Speed")
local coinsStat = leaderstats:WaitForChild("Coins")
local rebirthStat = leaderstats:WaitForChild("Rebirths")

local function renderShop()
	if not state or not state.Upgrades then
		return
	end
	for key, row in pairs(upgradeRows) do
		local upgrade = Config.Upgrades[key]
		local level = state.Upgrades[key] or 0
		row.level.Text = string.format("Nivel %d / %d", level, upgrade.MaxLevel)
		if key == "Jump" then
			row.effect.Text = string.format("+%d potencia de salto por nivel", upgrade.Effect)
		else
			row.effect.Text = string.format("+%d%% por nivel", math.floor(upgrade.Effect * 100))
		end
		if level >= upgrade.MaxLevel then
			row.buy.Text = "MAXIMO"
			row.buy.BackgroundColor3 = COLORS.panelLight
			row.buy.TextColor3 = COLORS.muted
		else
			local cost = Config.GetUpgradeCost(key, level)
			row.buy.Text = "Comprar " .. short(cost)
			if coinsStat.Value >= cost then
				row.buy.BackgroundColor3 = COLORS.green
				row.buy.TextColor3 = COLORS.bg
			else
				row.buy.BackgroundColor3 = COLORS.panelLight
				row.buy.TextColor3 = COLORS.muted
			end
		end
	end
end

local function updateRebirthButton()
	local canRebirth = speedStat.Value >= Config.RebirthRequirement
	rebirthButton.Text = "RENACER " .. short(Config.RebirthRequirement)
	rebirthButton.BackgroundColor3 = canRebirth and COLORS.green or COLORS.panelLight
	rebirthButton.TextColor3 = canRebirth and COLORS.bg or COLORS.muted
end

local function applyState(newState)
	if type(newState) ~= "table" then
		return
	end
	state = newState
	if state.Upgrades == nil then
		state.Upgrades = { Speed = 0, Coins = 0, Jump = 0 }
	end
	renderShop()
	updateRebirthButton()
end

local function setShop(open)
	shopOpen = open
	dimmer.Visible = open
	shopPanel.Visible = open
	if open then
		shopPanel.Size = UDim2.fromOffset(440, 356)
		TweenService:Create(shopPanel, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.fromOffset(470, 380),
		}):Play()
		renderShop()
	end
end

shopButton.Activated:Connect(function()
	setShop(not shopOpen)
end)
closeButton.Activated:Connect(function()
	setShop(false)
end)
dimmer.Activated:Connect(function()
	setShop(false)
end)
rebirthButton.Activated:Connect(function()
	Rebirth:FireServer()
end)

-- Display de velocidad con reconciliacion suave.
local displaySpeed = speedStat.Value
local lastServerSpeed = speedStat.Value
local lastKeyTime = 0

local function updateSpeedText()
	speedValue.Text = comma(displaySpeed)
end

updateSpeedText()

speedStat.Changed:Connect(function(value)
	local delta = value - lastServerSpeed
	if delta > 10 or delta < -10 or value > displaySpeed then
		displaySpeed = value
		updateSpeedText()
	end
	lastServerSpeed = value
	updateRebirthButton()
end)

coinsStat.Changed:Connect(function(value)
	coinsValue.Text = short(value)
	renderShop()
end)

rebirthStat.Changed:Connect(function(value)
	rebirthsValue.Text = tostring(value)
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local now = os.clock()
	if now - lastKeyTime < 1 / 30 then
		return
	end
	lastKeyTime = now
	displaySpeed += 1
	updateSpeedText()
end)

SyncState.OnClientEvent:Connect(applyState)
Notify.OnClientEvent:Connect(showToast)

task.spawn(function()
	for _ = 1, 12 do
		local ok, result = pcall(function()
			return GetState:InvokeServer()
		end)
		if ok and type(result) == "table" then
			applyState(result)
			return
		end
		task.wait(0.5)
	end
end)

coinsValue.Text = short(coinsStat.Value)
rebirthsValue.Text = tostring(rebirthStat.Value)
updateRebirthButton()

-- Progreso, FOV y pequenos efectos por frame.
RunService.RenderStepped:Connect(function(deltaTime)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local progress = math.clamp(-root.Position.Z / Config.TrackLength, 0, 1)
		progressFill.Size = UDim2.fromScale(progress, 1)
	end
	local camera = workspace.CurrentCamera
	if camera then
		local targetFov = 70 + math.min(25, speedStat.Value / 100)
		camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(1, deltaTime * 4)
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>