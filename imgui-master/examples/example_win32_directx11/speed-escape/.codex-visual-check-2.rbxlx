local function makePanel(name, size, zIndex)
	local panel = create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = C.bg,
		Visible = false,
		ZIndex = zIndex,
		Parent = screenGui,
	})
	corner(panel, 18)
	stroke(panel, C.accent, 2, 0.2)
	gradient(panel, Color3.fromRGB(13, 18, 38), Color3.fromRGB(26, 12, 45), 25)

	local scale = Instance.new("UIScale")
	scale.Parent = panel
	local function updateScale()
		local camera = workspace.CurrentCamera
		local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
		scale.Scale = math.clamp(math.min(
			(viewport.X - 36) / size.X.Offset,
			(viewport.Y - 36) / size.Y.Offset
		), 0.55, 1)
	end
	updateScale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	return panel
end

local function addTitle(panel, text)
	create("TextLabel", {
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -80, 0, 30),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = C.text,
		Font = FONT_BLACK,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = panel,
	})
end

local function addClose(panel)
	local button = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = C.panelLight,
		Text = "X",
		TextColor3 = C.text,
		Font = FONT_BLACK,
		TextSize = 16,
		Parent = panel,
	})
	corner(button, 8)
	button.Activated:Connect(function()
		if closePanel then
			closePanel()
		end
	end)
end

