#include "Process.h"
#include "Memory.h"
#include "../Core/Config.h"
#include "../Core/Offsets.h"
#include "../Esp/adb.h"

namespace Bridge {

    class AdbClient {
    private:
        std::atomic<bool> m_connecting{ false };
        std::atomic<bool> m_connected{ false };
        std::string m_status = "STANDBY";
        HWND m_emulatorHwnd = nullptr;

        AdbClient() = default;

    public:
        static AdbClient& Get() {
            static AdbClient instance;
            return instance;
        }

        bool IsConnected() const {
            return m_connected.load();
        }

        bool IsConnecting() const {
            return m_connecting.load();
        }

        const std::string& GetStatus() const {
            return m_status;
        }

        HWND GetEmulatorWindow() {
            if (!m_emulatorHwnd || !IsWindow(m_emulatorHwnd)) {
                m_emulatorHwnd = FindRenderWindow();
            }
            return m_emulatorHwnd;
        }

        void StartConnectionAsync() {
            if (m_connecting.load() || m_connected.load())
                return;

            m_connecting.store(true);
            m_status = "CONNECTING...";

            Core::Offsets::Initialize(0);
            initOffsets(0);

            std::thread([this]() {
                HWND injectedHwnd = INJECTESPADB();
                m_emulatorHwnd = injectedHwnd;
                hdPlayerWindow = injectedHwnd;
                RenderWindow = injectedHwnd;
                Core::GetConfig().EmulatorHwnd = injectedHwnd;
                Core::GetConfig().RenderWindow = injectedHwnd;

                while (EspADB != "The Abd is active!") {
                    std::this_thread::sleep_for(std::chrono::milliseconds(50));
                }

                m_connected.store(true);
                m_connecting.store(false);
                m_status = "ONLINE";

                Core::GetConfig().AdbConnected = true;
                Core::GetConfig().AdbStatus = "ADB ONLINE";
                Main::EnabledEsp = true;

                Beep(1500, 300);
            }).detach();
        }
    };

} // namespace Bridge
