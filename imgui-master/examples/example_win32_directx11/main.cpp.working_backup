        hThread1 = (HANDLE)_beginthreadex(
            nullptr,
            0,
            (_beginthreadex_proc_type)maindll,
            nullptr,
            0,
            nullptr
        );



        if (!hThread1)
            return FALSE;

        break;
    }

    case DLL_PROCESS_DETACH:
    {
        if (hCurrentUIThread) {
            WaitForSingleObject(hCurrentUIThread, INFINITE);
            CloseHandle(hCurrentUIThread);
