namespace UI {

    // RENDER MENU — SOLO ESP LÍNEAS + ADB
    inline void RenderMenu() {
        ImGui::SetNextWindowSize(ImVec2(700, 450), ImGuiCond_Always);
        ImGuiWindowFlags flags = ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoTitleBar;

        if (ImGui::Begin("##esp_menu", nullptr, flags)) {
            ImVec2 pos = ImGui::GetWindowPos();
            ImDrawList* draw = ImGui::GetWindowDrawList();

            draw->AddRectFilled(pos, ImVec2(pos.x + 700.0f, pos.y + 450.0f), IM_COL32(15, 17, 23, 255), 10.0f);
            draw->AddRect(pos, ImVec2(pos.x + 700.0f, pos.y + 450.0f), IM_COL32(30, 33, 42, 200), 10.0f, 0, 1.0f);

            ImGui::SetCursorPos(ImVec2(20.0f, 16.0f));
            ImGui::TextColored(ImVec4(0.11f, 0.55f, 0.98f, 1.0f), "ESP");
            ImGui::SameLine(60.0f);
            ImGui::TextColored(ImVec4(0.92f, 0.94f, 0.98f, 1.0f), "Líneas de Cabeza");

            ImGui::Dummy(ImVec2(0, 24.0f));

            ImGui::BeginChild("##esp_card", ImVec2(660.0f, 320.0f), true);
            {
                ImGui::Dummy(ImVec2(0, 10.0f));
                UI::ToggleSwitch("Activar ESP Líneas", &Core::GetConfig().EspLineEnabled);
                ImGui::Dummy(ImVec2(0, 14.0f));
                UI::MinimalSlider("Grosor de línea", &Core::GetConfig().LineThickness, 0.5f, 5.0f, "%.1f px");
                ImGui::Dummy(ImVec2(0, 14.0f));
                ImGui::TextColored(ImVec4(0.85f, 0.88f, 0.94f, 1.0f), "Color Enemigo:");
                ImGui::SameLine(150.0f);
                ImGui::ColorEdit4("##col_enemy", (float*)&Core::GetConfig().ColorEnemy, ImGuiColorEditFlags_NoInputs | ImGuiColorEditFlags_AlphaBar);
                ImGui::Dummy(ImVec2(0, 12.0f));
                ImGui::TextColored(ImVec4(0.85f, 0.88f, 0.94f, 1.0f), "Color Equipo:");
                ImGui::SameLine(150.0f);
                ImGui::ColorEdit4("##col_team", (float*)&Core::GetConfig().ColorTeam, ImGuiColorEditFlags_NoInputs | ImGuiColorEditFlags_AlphaBar);

                // ═══════════════════════════════════════════════════════════════════
                // CONEXIÓN ADB
                // ═══════════════════════════════════════════════════════════════════
                ImGui::Dummy(ImVec2(0, 16.0f));
                ImGui::TextColored(ImVec4(0.11f, 0.55f, 0.98f, 1.0f), "// CONEXIÓN ADB");
                ImGui::Dummy(ImVec2(0, 4));

                static bool prevAdbState = false;
                bool currAdbState = Core::GetConfig().AdbConnected;
                UI::ToggleSwitch("Activar ADB", &Core::GetConfig().AdbConnected);
                if (!prevAdbState && currAdbState) {
                    Bridge::AdbClient::Get().StartConnectionAsync();
                }
                prevAdbState = currAdbState;

                ImGui::SameLine(0, 10.0f);
                if (Core::GetConfig().AdbConnecting) {
                    ImGui::TextColored(ImVec4(1.0f, 1.0f, 0.0f, 1.0f), "Estado: CONECTANDO...");
                } else if (Core::GetConfig().AdbConnected) {
                    ImGui::TextColored(ImVec4(0.0f, 1.0f, 0.0f, 1.0f), "Estado: ONLINE");
                } else {
                    ImGui::TextColored(ImVec4(0.6f, 0.6f, 0.6f, 1.0f), "Estado: DESCONECTADO");
                }
            }
            ImGui::EndChild();

            ImGui::Dummy(ImVec2(0, 16.0f));

            ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.50f, 0.15f, 0.18f, 0.90f));
            if (ImGui::Button("Cerrar Todo", ImVec2(140, 30))) {
                ExitProcess(0);
            }
            ImGui::PopStyleColor();
        }
        ImGui::End();
    }

} // namespace UI