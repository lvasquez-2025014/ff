                    if (speedFeat) {
                        float spd = speedFeat->GetSpeedFactor();
                        if (MinimalSlider("Speed Factor", &spd, 1.0f, 4.0f, "%.2f")) {
                            speedFeat->SetSpeedFactor(spd);
                        }
                    }

                    ImGui::Dummy(ImVec2(0, 6));

                    auto medkitFeat = std::dynamic_pointer_cast<Features::Exploits::FastMedkitFeature>(
                        Features::FeatureManager::Get().FindFeature("Fast Medkit")
                    );
                    if (medkitFeat) {
                        float mspd = medkitFeat->GetSpeedMultiplier();
                        if (MinimalSlider("Medkit Rate", &mspd, 1.0f, 4.0f, "%.2f")) {
                            medkitFeat->SetSpeedMultiplier(mspd);
