    // Iconos de la Barra Lateral
    inline void DrawSidebarIcon(ImDrawList* draw, int index, ImVec2 center, bool active) {
        ImU32 col = active ? IM_COL32(29, 140, 248, 255) : IM_COL32(115, 120, 140, 255);

        if (index == 0) {
            // 1. Microchip / CPU (Visuals)
            draw->AddRect(ImVec2(center.x - 7.5f, center.y - 7.5f), ImVec2(center.x + 7.5f, center.y + 7.5f), col, 2.0f, 0, 1.5f);
            draw->AddRectFilled(ImVec2(center.x - 3.5f, center.y - 3.5f), ImVec2(center.x + 3.5f, center.y + 3.5f), col);
            // Patas chip
            draw->AddLine(ImVec2(center.x - 7.5f, center.y - 4.0f), ImVec2(center.x - 10.5f, center.y - 4.0f), col, 1.2f);
            draw->AddLine(ImVec2(center.x - 7.5f, center.y + 4.0f), ImVec2(center.x - 10.5f, center.y + 4.0f), col, 1.2f);
            draw->AddLine(ImVec2(center.x + 7.5f, center.y - 4.0f), ImVec2(center.x + 10.5f, center.y - 4.0f), col, 1.2f);
            draw->AddLine(ImVec2(center.x + 7.5f, center.y + 4.0f), ImVec2(center.x + 10.5f, center.y + 4.0f), col, 1.2f);
        }
        else if (index == 1) {
            // 2. Calavera / Skull (ADB Bridge)
            draw->AddCircle(ImVec2(center.x, center.y - 2.5f), 6.0f, col, 16, 1.5f);
            draw->AddRectFilled(ImVec2(center.x - 3.0f, center.y + 3.0f), ImVec2(center.x + 3.0f, center.y + 7.0f), col);
            // Huesos cruzados
            draw->AddLine(ImVec2(center.x - 8.0f, center.y + 7.0f), ImVec2(center.x + 8.0f, center.y - 5.0f), col, 1.2f);
            draw->AddLine(ImVec2(center.x - 8.0f, center.y - 5.0f), ImVec2(center.x + 8.0f, center.y + 7.0f), col, 1.2f);
        }
        else if (index == 2) {
            // 3. Radar / Ojo tachado (Exploits)
            draw->AddCircle(center, 7.0f, col, 16, 1.5f);
            draw->AddCircleFilled(center, 2.5f, col);
            draw->AddLine(ImVec2(center.x - 9.0f, center.y + 7.0f), ImVec2(center.x + 9.0f, center.y - 7.0f), col, 1.5f);
        }
        else if (index == 3) {
            // 4. Usuario / Perfil de Jugador (Exacto al 4to icono de la foto)
            draw->AddCircle(ImVec2(center.x, center.y - 3.5f), 4.2f, col, 16, 1.5f);
            // Hombros curvados
            draw->AddLine(ImVec2(center.x - 7.0f, center.y + 7.0f), ImVec2(center.x - 3.0f, center.y + 3.5f), col, 1.5f);
            draw->AddLine(ImVec2(center.x - 3.0f, center.y + 3.5f),  ImVec2(center.x + 3.0f, center.y + 3.5f), col, 1.5f);
            draw->AddLine(ImVec2(center.x + 3.0f, center.y + 3.5f),  ImVec2(center.x + 7.0f, center.y + 7.0f), col, 1.5f);
        }
        else if (index == 4) {
            // 5. Engranaje / Configuración (Anclado al fondo)
            draw->AddCircle(center, 4.0f, col, 16, 1.6f);
            for (int i = 0; i < 6; i++) {
                float a = i * (IM_PI / 3.0f);
                ImVec2 p1(center.x + cosf(a) * 4.5f, center.y + sinf(a) * 4.5f);
                ImVec2 p2(center.x + cosf(a) * 8.0f, center.y + sinf(a) * 8.0f);
                draw->AddLine(p1, p2, col, 1.8f);
            }
        }
    }

    // Icono Aim / Retícula para la cabecera de la tarjeta izquierda
    inline void DrawCardAimIcon(ImDrawList* draw, ImVec2 center, ImU32 col) {
        draw->AddCircle(center, 5.5f, col, 16, 1.4f);
        draw->AddCircleFilled(center, 2.0f, col);
        draw->AddLine(ImVec2(center.x - 8.0f, center.y), ImVec2(center.x - 5.5f, center.y), col, 1.4f);
        draw->AddLine(ImVec2(center.x + 5.5f, center.y), ImVec2(center.x + 8.0f, center.y), col, 1.4f);
        draw->AddLine(ImVec2(center.x, center.y - 8.0f), ImVec2(center.x, center.y - 5.5f), col, 1.4f);
        draw->AddLine(ImVec2(center.x, center.y + 5.5f), ImVec2(center.x, center.y + 8.0f), col, 1.4f);
    }

    // Icono Sliders / Equalizer para la cabecera de la tarjeta derecha
    inline void DrawCardSlidersIcon(ImDrawList* draw, ImVec2 center, ImU32 col) {
        draw->AddLine(ImVec2(center.x - 7.0f, center.y - 4.5f), ImVec2(center.x + 7.0f, center.y - 4.5f), col, 1.3f);
        draw->AddCircleFilled(ImVec2(center.x - 3.0f, center.y - 4.5f), 2.0f, col);

        draw->AddLine(ImVec2(center.x - 7.0f, center.y), ImVec2(center.x + 7.0f, center.y), col, 1.3f);
        draw->AddCircleFilled(ImVec2(center.x + 3.0f, center.y), 2.0f, col);

        draw->AddLine(ImVec2(center.x - 7.0f, center.y + 4.5f), ImVec2(center.x + 7.0f, center.y + 4.5f), col, 1.3f);
        draw->AddCircleFilled(ImVec2(center.x - 1.0f, center.y + 4.5f), 2.0f, col);
    }

    // Silueta estilizada de tiburón (exacta al logo BR MODS de la foto)
    inline void DrawSharkLogo(ImDrawList* draw, ImVec2 pos) {
        ImU32 col = IM_COL32(29, 140, 248, 255);
        ImU32 colDark = IM_COL32(16, 95, 175, 255);

        // Aleta dorsal superior
        ImVec2 finPts[] = {
            ImVec2(pos.x + 12.0f, pos.y + 14.0f),
            ImVec2(pos.x + 16.0f, pos.y + 2.0f),
            ImVec2(pos.x + 22.0f, pos.y + 12.0f)
        };
        draw->AddConvexPolyFilled(finPts, 3, col);

        // Cabeza y mandíbula de tiburón
        ImVec2 bodyPts[] = {
            ImVec2(pos.x + 2.0f,  pos.y + 24.0f),
            ImVec2(pos.x + 8.0f,  pos.y + 14.0f),
            ImVec2(pos.x + 22.0f, pos.y + 12.0f),
            ImVec2(pos.x + 32.0f, pos.y + 14.0f),
            ImVec2(pos.x + 26.0f, pos.y + 22.0f),
            ImVec2(pos.x + 18.0f, pos.y + 27.0f),
            ImVec2(pos.x + 8.0f,  pos.y + 26.0f)
        };
        draw->AddConvexPolyFilled(bodyPts, 7, col);

        // Ojo blanco agresivo
        draw->AddCircleFilled(ImVec2(pos.x + 25.0f, pos.y + 15.0f), 1.5f, IM_COL32(255, 255, 255, 255));

        // Branquias en tono más oscuro
        draw->AddLine(ImVec2(pos.x + 17.0f, pos.y + 17.0f), ImVec2(pos.x + 15.5f, pos.y + 22.0f), colDark, 1.2f);
        draw->AddLine(ImVec2(pos.x + 19.5f, pos.y + 17.0f), ImVec2(pos.x + 18.0f, pos.y + 22.0f), colDark, 1.2f);
    }

    inline void RenderMenu() {
        auto& cfg = Core::GetConfig();
        SetupImGuiStyle();

        // ═════════════════════════════════════════════════════════════════════
        // 1. PANTALLA DE ACCESO MINIMALISTA
        // ═════════════════════════════════════════════════════════════════════
        if (!cfg.Authenticated && cfg.ShowLogin) {
            if (cfg.Loading) {
                ImGui::SetNextWindowSize(ImVec2(320, 200), ImGuiCond_Always);
                if (ImGui::Begin("##auth_loading", nullptr, ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoTitleBar)) {
                    cfg.Progress += 0.35f * ImGui::GetIO().DeltaTime;
                    DrawCircularProgressBar(cfg.Progress, 3.5f, IM_COL32(29, 140, 248, 255), "Autenticando...");
                    if (cfg.Progress >= 1.0f) {
                        cfg.Loading = false;
                        cfg.Authenticated = true;
                        cfg.ShowLogin = false;
                    }
                }
                ImGui::End();
                return;
            }

            ImGui::SetNextWindowSize(ImVec2(320, 200), ImGuiCond_Always);
            if (ImGui::Begin("##auth_box", nullptr, ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoTitleBar)) {
                ImGui::TextColored(ImVec4(0.11f, 0.55f, 0.98f, 1.0f), "BR MODS");
                ImGui::SameLine();
                ImGui::TextColored(ImVec4(0.45f, 0.48f, 0.55f, 1.0f), "// LOGIN");
                ImGui::Separator();
                ImGui::Dummy(ImVec2(0, 4));

                ImGui::PushItemWidth(290);
                ImGui::InputTextWithHint("##usr", "Usuario", cfg.Username, sizeof(cfg.Username));
                ImGui::InputTextWithHint("##pwd", "Contraseña", cfg.Password, sizeof(cfg.Password), ImGuiInputTextFlags_Password);
                ImGui::PopItemWidth();

                ImGui::Dummy(ImVec2(0, 8));

                if (ImGui::Button("Iniciar Sesión", ImVec2(140, 28))) {
                    cfg.Loading = true;
                    cfg.Progress = 0.0f;
                }
                ImGui::SameLine();
                if (ImGui::Button("Acceso Rápido", ImVec2(140, 28))) {
                    cfg.Authenticated = true;
                    cfg.ShowLogin = false;
                }
            }
            ImGui::End();
            return;
        }

        // Si el menú está cerrado mediante [INSERT], no dibujarlo
        if (!cfg.MenuOpen)
            return;

        // ═════════════════════════════════════════════════════════════════════
        // 2. GUI MINIMALISTA PROPORCIONADA Y ESPACIOSA (780 x 520 px)
        // ═════════════════════════════════════════════════════════════════════
        ImGui::SetNextWindowSize(ImVec2(780, 520), ImGuiCond_Always);
        ImGuiWindowFlags flags = ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoTitleBar;

        if (ImGui::Begin("##brmods_minimal_gui", nullptr, flags)) {
            ImVec2 pos = ImGui::GetWindowPos();
            ImVec2 size = ImGui::GetWindowSize();
            ImDrawList* draw = ImGui::GetWindowDrawList();

            // Fondo carbón y borde curvado exterior suave
            draw->AddRect(pos, ImVec2(pos.x + size.x, pos.y + size.y), IM_COL32(32, 35, 45, 240), 12.0f, 0, 1.2f);

            // ─── A. ENCABEZADO SUPERIOR (LOGO, TITULO, SUBTITULO, BOTON EXIT) ─
            // 1. Logotipo de Tiburón en azul eléctrico
            ImVec2 logoPos = ImVec2(pos.x + 18.0f, pos.y + 14.0f);
            if (logo) {
                draw->AddImage(logo, logoPos, ImVec2(logoPos.x + 36.0f, logoPos.y + 36.0f));
            } else {
                DrawSharkLogo(draw, logoPos);
            }

            // 2. Título "BR MODS" (BR en azul eléctrico #1d8cf8, MODS en blanco puro)
            ImGui::SetCursorPos(ImVec2(60, 14));
            ImGui::TextColored(ImVec4(0.11f, 0.55f, 0.98f, 1.0f), "BR");
            ImGui::SameLine(0, 5);
            ImGui::TextColored(ImVec4(0.96f, 0.97f, 1.0f, 1.0f), "MODS");

            // 3. Subtítulo "Internal Free Fire - V7A" en gris tenue
            ImGui::SetCursorPos(ImVec2(60, 32));
            ImGui::TextColored(ImVec4(0.48f, 0.52f, 0.60f, 1.0f), "Internal Free Fire - V7A");

            // 4. Botón de Salida Superior Derecho (Cuadrado azul con icono de salida/puerta)
            ImVec2 exitBtnPos = ImVec2(pos.x + size.x - 42.0f, pos.y + 14.0f);
            bool exitHovered = ImGui::IsMouseHoveringRect(exitBtnPos, ImVec2(exitBtnPos.x + 28.0f, exitBtnPos.y + 28.0f));
            ImU32 exitBgCol = exitHovered ? IM_COL32(50, 155, 255, 255) : IM_COL32(29, 140, 248, 255);
            draw->AddRectFilled(exitBtnPos, ImVec2(exitBtnPos.x + 28.0f, exitBtnPos.y + 28.0f), exitBgCol, 7.0f);

            // Icono blanco puerta y flecha de salida [->]
            ImU32 whiteCol = IM_COL32(255, 255, 255, 255);
            draw->AddLine(ImVec2(exitBtnPos.x + 16.0f, exitBtnPos.y + 8.0f),  ImVec2(exitBtnPos.x + 21.0f, exitBtnPos.y + 8.0f), whiteCol, 1.8f);
            draw->AddLine(ImVec2(exitBtnPos.x + 21.0f, exitBtnPos.y + 8.0f),  ImVec2(exitBtnPos.x + 21.0f, exitBtnPos.y + 20.0f), whiteCol, 1.8f);
            draw->AddLine(ImVec2(exitBtnPos.x + 21.0f, exitBtnPos.y + 20.0f), ImVec2(exitBtnPos.x + 16.0f, exitBtnPos.y + 20.0f), whiteCol, 1.8f);
            draw->AddLine(ImVec2(exitBtnPos.x + 7.0f,  exitBtnPos.y + 14.0f), ImVec2(exitBtnPos.x + 16.5f, exitBtnPos.y + 14.0f), whiteCol, 1.8f);
            draw->AddLine(ImVec2(exitBtnPos.x + 13.0f, exitBtnPos.y + 10.5f), ImVec2(exitBtnPos.x + 16.5f, exitBtnPos.y + 14.0f), whiteCol, 1.8f);
            draw->AddLine(ImVec2(exitBtnPos.x + 13.0f, exitBtnPos.y + 17.5f), ImVec2(exitBtnPos.x + 16.5f, exitBtnPos.y + 14.0f), whiteCol, 1.8f);

            // Clic en el botón de salida superior -> Cierra todo inmediatamente
            ImGui::SetCursorScreenPos(exitBtnPos);
            if (ImGui::InvisibleButton("##exit_top_btn", ImVec2(28.0f, 28.0f))) {
                Bridge::TerminateAllBlueStacksProcesses();
                ExitProcess(0);
            }

            // ─── B. BARRA LATERAL IZQUIERDA (SLIM RAIL CON 5 ICONOS) ─────────
            float railX = pos.x + 14.0f;
            float railY = pos.y + 56.0f;
            float railW = 48.0f;
            float railH = size.y - 70.0f;

            // Fondo del rail
            draw->AddRectFilled(ImVec2(railX, railY), ImVec2(railX + railW, railY + railH), IM_COL32(13, 14, 18, 255), 8.0f);
            draw->AddRect(ImVec2(railX, railY), ImVec2(railX + railW, railY + railH), IM_COL32(24, 26, 34, 200), 8.0f);

            // 4 Iconos superiores en el rail (0: Chip, 1: Skull, 2: Radar, 3: User)
            for (int i = 0; i < 4; i++) {
                ImVec2 iconCenter = ImVec2(railX + railW * 0.5f, railY + 28.0f + (i * 54.0f));
                bool active = (cfg.ActiveTab == i);

                ImGui::SetCursorScreenPos(ImVec2(iconCenter.x - 20.0f, iconCenter.y - 20.0f));
                char tabBtnId[16];
                sprintf_s(tabBtnId, "##tab_%d", i);
                if (ImGui::InvisibleButton(tabBtnId, ImVec2(40.0f, 40.0f))) {
                    cfg.ActiveTab = i;
                }

                DrawSidebarIcon(draw, i, iconCenter, active);

                // Línea indicadora vertical azul en el borde derecho del rail
                if (active) {
                    draw->AddRectFilled(
                        ImVec2(railX + railW - 3.0f, iconCenter.y - 13.0f),
                        ImVec2(railX + railW, iconCenter.y + 13.0f),
                        IM_COL32(29, 140, 248, 255),
                        1.5f
                    );
                }
            }

            // 5to Icono: Engranaje (Settings) anclado en la parte inferior del rail
            {
                ImVec2 gearCenter = ImVec2(railX + railW * 0.5f, railY + railH - 28.0f);
                bool active = (cfg.ActiveTab == 4);

                ImGui::SetCursorScreenPos(ImVec2(gearCenter.x - 20.0f, gearCenter.y - 20.0f));
                if (ImGui::InvisibleButton("##tab_gear", ImVec2(40.0f, 40.0f))) {
                    cfg.ActiveTab = 4;
                }

                DrawSidebarIcon(draw, 4, gearCenter, active);

                if (active) {
                    draw->AddRectFilled(
                        ImVec2(railX + railW - 3.0f, gearCenter.y - 13.0f),
                        ImVec2(railX + railW, gearCenter.y + 13.0f),
                        IM_COL32(29, 140, 248, 255),
                        1.5f
                    );
                }
            }

            // ─── C. AREA DE CONTENIDO EN 2 TARJETAS PARALELAS AMPLIAS ────────
            float leftMargin = 72.0f;
            float rightMargin = 16.0f;
            float cardGap = 16.0f;
            float totalCardsW = size.x - leftMargin - rightMargin;
            float card1W = (totalCardsW - cardGap) * 0.49f;
            float card2W = totalCardsW - cardGap - card1W;
            float card1X = pos.x + leftMargin;
            float card2X = card1X + card1W + cardGap;
            float cardY  = pos.y + 56.0f;
            float cardH  = size.y - 70.0f;

            // Función auxiliar para dibujar tarjetas con icono y línea separadora azul
            auto DrawCard = [&](ImVec2 cPos, ImVec2 cSize, const char* title, bool isAimIcon, const char* childId) {
                // Fondo de la tarjeta y borde sutil
                draw->AddRectFilled(cPos, ImVec2(cPos.x + cSize.x, cPos.y + cSize.y), IM_COL32(19, 21, 28, 255), 8.0f);
                draw->AddRect(cPos, ImVec2(cPos.x + cSize.x, cPos.y + cSize.y), IM_COL32(28, 31, 42, 180), 8.0f);

                // Icono azul de la cabecera
                ImVec2 iconPt = ImVec2(cPos.x + 16.0f, cPos.y + 16.0f);
                if (isAimIcon) {
                    DrawCardAimIcon(draw, iconPt, IM_COL32(29, 140, 248, 255));
                } else {
                    DrawCardSlidersIcon(draw, iconPt, IM_COL32(29, 140, 248, 255));
                }

                // Título de la tarjeta
                draw->AddText(ImVec2(cPos.x + 28.0f, cPos.y + 9.0f), IM_COL32(236, 240, 250, 255), title);

                // Línea separadora azul horizontal idéntica a la imagen
                draw->AddLine(
                    ImVec2(cPos.x + 10.0f, cPos.y + 29.0f),
                    ImVec2(cPos.x + cSize.x - 10.0f, cPos.y + 29.0f),
                    IM_COL32(29, 140, 248, 220),
                    1.2f
                );

                // Iniciar región desplazable limpia
                ImGui::SetCursorScreenPos(ImVec2(cPos.x + 12.0f, cPos.y + 36.0f));
                ImGui::BeginChild(childId, ImVec2(cSize.x - 24.0f, cSize.y - 44.0f), false);
            };

            // ═════════════════════════════════════════════════════════════════
            // CONTENIDO DE CADA PESTAÑA CON EL ESTILO BR MODS
            // ═════════════════════════════════════════════════════════════════

            // PESTAÑA 0: VISUALES (ESP)
            if (cfg.ActiveTab == 0) {
                // Tarjeta Izquierda: Interruptores Principales ESP
                DrawCard(ImVec2(card1X, cardY), ImVec2(card1W, cardH), "ESP", true, "##child_esp_main");
                {
                    ImGui::Dummy(ImVec2(0, 2));
                    ToggleSwitch("ESP Líneas", &cfg.EspLineEnabled);

                    ImGui::Dummy(ImVec2(0, 4));
                    ToggleSwitch("ESP Box", &cfg.EspBoxEnabled);

                    ImGui::Dummy(ImVec2(0, 4));
                    ToggleSwitch("ESP Vida", &cfg.EspHealthEnabled);

                    ImGui::Dummy(ImVec2(0, 4));
                    ToggleSwitch("ESP Esqueleto", &cfg.EspSkeletonEnabled);

                    ImGui::Dummy(ImVec2(0, 4));
                    ToggleSwitch("ESP Nombre", &cfg.EspNameEnabled);

                    ImGui::Dummy(ImVec2(0, 4));
                    ToggleSwitch("Mostrar Aliados", &cfg.ShowTeam);
                }
                ImGui::EndChild();

                // Tarjeta Derecha: Ajustes y Estilos de ESP
                DrawCard(ImVec2(card2X, cardY), ImVec2(card2W, cardH), "ESP Settings", false, "##child_esp_settings");
                {
                    ImGui::Dummy(ImVec2(0, 2));

                    // Sliders con etiqueta arriba y valor alineado a la derecha
                    MinimalSlider("Grosor Línea", &cfg.LineThickness, 0.5f, 5.0f, "%.1f px");
                    ImGui::Dummy(ImVec2(0, 4));
                    MinimalSlider("Grosor Caja", &cfg.BoxThickness, 0.5f, 4.0f, "%.1f px");
                    ImGui::Dummy(ImVec2(0, 4));
                    MinimalSlider("Grosor Esqueleto", &cfg.SkeletonThickness, 0.5f, 4.0f, "%.1f px");

                    ImGui::Dummy(ImVec2(0, 6));

                    // Selector de Estilo de Caja
                    ImGui::TextColored(ImVec4(0.85f, 0.88f, 0.94f, 1.0f), "Estilo Caja:");
                    ImGui::Dummy(ImVec2(0, 1));
                    if (ImGui::Button(cfg.EspBoxStyle == 0 ? "● 2D" : "○ 2D", ImVec2(75, 24))) cfg.EspBoxStyle = 0;
                    ImGui::SameLine();
                    if (ImGui::Button(cfg.EspBoxStyle == 1 ? "● Corner" : "○ Corner", ImVec2(85, 24))) cfg.EspBoxStyle = 1;
                    ImGui::SameLine();
                    if (ImGui::Button(cfg.EspBoxStyle == 2 ? "● Filled" : "○ Filled", ImVec2(75, 24))) cfg.EspBoxStyle = 2;

                    ImGui::Dummy(ImVec2(0, 8));
                    ImGui::TextColored(ImVec4(0.55f, 0.58f, 0.68f, 1.0f), "Colores:");
                    ImGui::Dummy(ImVec2(0, 1));

                    ImGui::ColorEdit4("Línea", (float*)&cfg.ColorEnemy, ImGuiColorEditFlags_NoInputs | ImGuiColorEditFlags_AlphaBar);
                    ImGui::SameLine(75);
                    ImGui::ColorEdit4("Caja", (float*)&cfg.ColorBox, ImGuiColorEditFlags_NoInputs | ImGuiColorEditFlags_AlphaBar);
                    ImGui::SameLine(150);
                    ImGui::ColorEdit4("Huesos", (float*)&cfg.ColorSkeleton, ImGuiColorEditFlags_NoInputs | ImGuiColorEditFlags_AlphaBar);
                    ImGui::SameLine(225);
                    ImGui::ColorEdit4("Nombre", (float*)&cfg.ColorName, ImGuiColorEditFlags_NoInputs | ImGuiColorEditFlags_AlphaBar);
                }
                ImGui::EndChild();
            }

            // PESTAÑA 1: CONEXIÓN ADB (BRIDGE)
            else if (cfg.ActiveTab == 1) {
                DrawCard(ImVec2(card1X, cardY), ImVec2(card1W, cardH), "ADB Bridge", true, "##child_adb_main");
                {
                    ImGui::Dummy(ImVec2(0, 4));

                    bool adbActive = Bridge::AdbClient::Get().IsConnected() || cfg.AdbConnected;
                    if (!adbActive) {
                        ImGui::PushStyleColor(ImGuiCol_Button, IM_COL32(29, 140, 248, 255));
                        ImGui::PushStyleColor(ImGuiCol_Text, ImVec4(1.0f, 1.0f, 1.0f, 1.0f));
                        if (ImGui::Button("Conectar ADB", ImVec2(186, 28))) {
