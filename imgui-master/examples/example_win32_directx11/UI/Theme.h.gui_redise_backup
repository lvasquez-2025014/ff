    inline void ToggleClickability(HWND targetHwnd, bool clickable) {
        if (!targetHwnd) return;
        LONG_PTR exStyle = GetWindowLongPtr(targetHwnd, GWL_EXSTYLE);
        exStyle = clickable ? (exStyle & ~WS_EX_TRANSPARENT) : (exStyle | WS_EX_TRANSPARENT);
        SetWindowLongPtr(targetHwnd, GWL_EXSTYLE, exStyle);
        SetLayeredWindowAttributes(targetHwnd, RGB(0, 0, 0), 255, LWA_ALPHA);
        RedrawWindow(targetHwnd, nullptr, nullptr, RDW_ERASE | RDW_INVALIDATE | RDW_FRAME);
    }

